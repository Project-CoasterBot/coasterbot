# Webots project - overrides for the repo-root .gitignore.

# Re-include the controller Makefiles (root .gitignore has "Makefile*").
!controllers/coasterbot/Makefile
!controllers/epuck_avoid_collision/Makefile
!controllers/epuck_go_forward/Makefile

# Compiled controller binaries (regenerated by `make`).
controllers/coasterbot/coasterbot
controllers/epuck_avoid_collision/epuck_avoid_collision
controllers/epuck_go_forward/epuck_go_forward

# Large unused raw CAD exports of the robot.
worlds/Coasterbot.dae
worlds/Coasterbot.obj

# Auto-generated world preview thumbnails.
worlds/.*.jpg
