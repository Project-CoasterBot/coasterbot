#VRML_SIM R2025b utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/033dbaea1a43fb2ae69217f200847d8825a254f6/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/033dbaea1a43fb2ae69217f200847d8825a254f6/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/033dbaea1a43fb2ae69217f200847d8825a254f6/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "../protos/coasterbot/Coasterbot.proto"

WorldInfo {
  basicTimeStep 16
}
Viewpoint {
  orientation -0.15 0.16 0.97 1.6
  position 0.2 -5.6 5.2
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Floor {
  size 4 4
  tileSize 0.25 0.25
}
# --- Scenario for the coasterbot controller's MODE_NAVIGATE ---
# The occupancy grid + start + goal in main.cpp (namespace nav_scenario)
# MUST match the geometry below. World frame: X right, Y up-the-page, Z up.
Coasterbot {
  translation 0 -1.2 0.05
  rotation 1 0 0 1.5708
  controller "coasterbot"
}
# Wall 1, gap on the right (grid rect x[-1.5,0.4] y[-0.55,-0.45])
Solid {
  translation -0.55 -0.5 0.075
  children [
    DEF WALL1 Shape {
      appearance PBRAppearance {
        baseColor 0.55 0.35 0.25
        roughness 1
      }
      geometry Box {
        size 1.9 0.1 0.15
      }
    }
  ]
  name "wall 1"
  boundingObject USE WALL1
}
# Wall 2, gap on the left (grid rect x[-0.4,1.5] y[0.45,0.55])
Solid {
  translation 0.55 0.5 0.075
  children [
    DEF WALL2 Shape {
      appearance PBRAppearance {
        baseColor 0.3 0.4 0.6
        roughness 1
      }
      geometry Box {
        size 1.9 0.1 0.15
      }
    }
  ]
  name "wall 2"
  boundingObject USE WALL2
}
# Goal marker (visual only, no collision) at (0, 1.2)
Solid {
  translation 0 1.2 0.002
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.85 0.3
        emissiveColor 0.05 0.4 0.15
      }
      geometry Cylinder {
        height 0.004
        radius 0.06
      }
    }
  ]
  name "goal marker"
}
