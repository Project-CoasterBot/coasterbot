#VRML_SIM R2025b utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/033dbaea1a43fb2ae69217f200847d8825a254f6/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/033dbaea1a43fb2ae69217f200847d8825a254f6/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/033dbaea1a43fb2ae69217f200847d8825a254f6/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "../protos/coasterbot/Coasterbot.proto"

WorldInfo {
  basicTimeStep 16
  randomSeed 1  # fest statt Default 0 ("aktuelle Zeit"), fuer Reproduzierbarkeit (ST-SIM-004)
}
Viewpoint {
  orientation -0.13 0.14 0.98 1.6
  position 0.6 -5.6 5.2
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Floor {
  size 4 4
  tileSize 0.25 0.25
}
# --- Scenario for MODE_NAVIGATE_DSTAR ---
# Wall with two gaps (grid: dstar_scenario in main.cpp). Robot plans through
# the RIGHT gap (dead ahead); the orange box there is NOT in the robot's map
# and is discovered by the ultrasonic -> D* Lite reroutes through the LEFT gap.
Coasterbot {
  translation 0.7 -1.2 0.05
  rotation 1 0 0 1.5708
  controller "coasterbot"
}
# Wall segment: left edge  (grid x[-1.5,-1.3])
Solid {
  translation -1.4 0 0.075
  children [
    DEF W1 Shape {
      appearance PBRAppearance { baseColor 0.55 0.35 0.25 roughness 1 }
      geometry Box { size 0.2 0.1 0.15 }
    }
  ]
  name "wall seg 1"
  boundingObject USE W1
}
# Wall segment: centre divider  (grid x[-0.1,0.1])
Solid {
  translation 0 0 0.075
  children [
    DEF W2 Shape {
      appearance PBRAppearance { baseColor 0.55 0.35 0.25 roughness 1 }
      geometry Box { size 0.2 0.1 0.15 }
    }
  ]
  name "wall seg 2"
  boundingObject USE W2
}
# Wall segment: right edge  (grid x[1.3,1.5])
Solid {
  translation 1.4 0 0.075
  children [
    DEF W3 Shape {
      appearance PBRAppearance { baseColor 0.55 0.35 0.25 roughness 1 }
      geometry Box { size 0.2 0.1 0.15 }
    }
  ]
  name "wall seg 3"
  boundingObject USE W3
}
# UNMAPPED obstacle blocking the right gap (discovered at runtime)
Solid {
  translation 0.7 0 0.075
  children [
    DEF BOX Shape {
      appearance PBRAppearance { baseColor 0.85 0.4 0.1 roughness 1 }
      geometry Box { size 1.2 0.24 0.15 }
    }
  ]
  name "unmapped box"
  boundingObject USE BOX
}
# Goal marker (visual only) at (0.6, 1.2)
Solid {
  translation 0.7 1.2 0.002
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.85 0.3
        emissiveColor 0.05 0.4 0.15
      }
      geometry Cylinder { height 0.004 radius 0.06 }
    }
  ]
  name "goal marker"
}
