WorldInfo {
  basicTimeStep 16
}
Viewpoint {
  orientation -0.35 0.36 0.86 1.72
  position 1.6 -1.6 1.4
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Floor {
  size 4 4
  tileSize 0.25 0.25
}
Coasterbot {
  # Open floor, no obstacles — for navigation-stack bring-up (odometry, A*, DWA).
  # PROTO is Y-up; this rotation stands it upright in the Z-up world.
  translation 0 0 0.05
  rotation 1 0 0 1.5708
  controller "coasterbot"
}
